[resource]
script = ExtResource("1_building_data")
category = 1
sort_id = 30
id = &"militia_camp"
display_name = "民兵营"
description = "为普通居民提供民兵训练场所。
点击训练民兵后，自动安排空闲居民前往训练位。"

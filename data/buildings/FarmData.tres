[gd_resource type="Resource" script_class="BuildingData" format=3]

[ext_resource type="Script" path="res://Script/building_data.gd" id="1_farm_data"]
[ext_resource type="PackedScene" path="res://Scene/building/game/farm.tscn" id="2_farm_scene"]

[resource]
script = ExtResource("1_farm_data")
id = &"farm"
display_name = "农场"
description = "为居民提供种植粮食的工作地点。"
function_text = "阶段 1 为空壳建筑，暂不生产粮食。"

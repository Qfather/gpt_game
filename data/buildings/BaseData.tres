[gd_resource type="Resource" script_class="BuildingData" format=3]

[ext_resource type="Script" path="res://Script/building_data.gd" id="1_data"]
[ext_resource type="PackedScene" path="res://Scene/building/base.tscn" id="2_scene"]

[resource]
script = ExtResource("1_data")
id = &"base"
display_name = "据点"
